# Copy this file to .env and edit. Never commit or submit .env.

# --- Provider -------------------------------------------------------------
# gemini  = google-genai (default). Needs GEMINI_API_KEY below. This is the
#           intended path and what the submitted run was produced with.
# ollama  = a local model, for building without spending free-tier quota.
#           Needs `ollama serve` and `ollama pull llama3.1:8b`.
# offline = deterministic heuristics: no network, no key, not a language
#           model. The other two fall back to it per message on failure, so
#           every command still runs on a machine with no key.
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
MODEL_NAME=gemini-2.5-flash
TEMPERATURE=0

# Free-tier pacing: seconds between calls, and how many times to retry a 429.
# On a 429 the wait comes from the server's retryDelay / Retry-After when it
# sends one. A daily-cap 429 stops the API calls for the rest of the run.
LLM_CALL_DELAY=4
LLM_MAX_RETRIES=3

# --- Local model (LLM_PROVIDER=ollama) ------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# --- The mailbox ----------------------------------------------------------
INBOX_FILE=inbox.json
OWNER_ADDRESS=sam@paperjet.io
OWNER_NAME=Sam
OWNER_DOMAINS=paperjet.io

# The inbox is a fixed snapshot, so "today" is fixed too and every run
# resolves "Wednesday at 2:00pm" the same way.
TODAY=2026-09-10

# --- Files a run writes ---------------------------------------------------
OUTBOX_DIR=outbox
TRACE_FILE=trace.jsonl
PREFS_FILE=prefs.json
DECISIONS_FILE=decisions.json
GATE_LOG_FILE=gate_log.json
DASHBOARD_JSON=dashboard.json
DASHBOARD_HTML=dashboard.html
